#!/bin/bash
#PBS -N upf_aggregate
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=00:30:00
#PBS -q workq
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
source pbs/env.sh

CAMPAIGN_ID="${CAMPAIGN_ID:-demo-v1}"
OUTPUT_ROOT="${OUTPUT_ROOT:-output/macro}"
EXPECTED_SHARDS="${EXPECTED_SHARDS:-30}"
CAMPAIGN_ROOT="$OUTPUT_ROOT/schema_major=2/campaign=$CAMPAIGN_ID"

"$PYTHON_BIN" -m experiments.aggregate_campaign \
    --root "$CAMPAIGN_ROOT" \
    --expected-shards "$EXPECTED_SHARDS" \
    --output "$CAMPAIGN_ROOT/campaign-summary.json"
