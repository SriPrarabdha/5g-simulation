#!/bin/bash
#PBS -N cdot-v4-valanalyze
#PBS -q workq
#PBS -l select=1:ncpus=125:mem=120gb
#PBS -l place=excl
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
source pbs/env.sh
: "${CAMPAIGN_ROOT:?}"; : "${VALIDATION_OUTPUT:?}"
: "${VAL_CELLS:=1250}"
exec "$PYTHON_BIN" -m experiments.analyze_mixed_stress_v4 \
  --root "$CAMPAIGN_ROOT" --output "$VALIDATION_OUTPUT" --workers 40 \
  --stage-dir validation --prefix arm --cells "$VAL_CELLS" --expected-arms 0
