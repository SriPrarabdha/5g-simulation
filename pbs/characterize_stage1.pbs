#!/bin/bash
#PBS -N cdot-stage1-characterize
#PBS -q workq
#PBS -l select=1:ncpus=128
#PBS -l place=excl
#PBS -l walltime=08:00:00
#PBS -l mem=120gb
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"
source pbs/env.sh

: "${WORKER_COUNT:?set WORKER_COUNT to 8, 16, 32, or 64}"
: "${REPETITION:?set REPETITION to 1, 2, or 3}"
: "${WORK_LIST:?set WORK_LIST to the frozen interleaved work-list JSON}"
: "${CAMPAIGN_ROOT:?set CAMPAIGN_ROOT to shared campaign storage}"
: "${ALLOCATED_MEMORY_BYTES:?record the PBS memory allocation in bytes}"

# PBS_JOBFS is an optional site extension and is not configured on C-DOT's
# PBS server.  Prefer it when present, otherwise use the job TMPDIR or the
# compute node's local /tmp filesystem.  A private directory prevents jobs
# and retries from sharing checkpoint/segment paths.
SCRATCH_BASE="${PBS_JOBFS:-${TMPDIR:-/tmp}}"
if [ ! -d "$SCRATCH_BASE" ] || [ ! -w "$SCRATCH_BASE" ]; then
  echo "ERROR: scratch base is not a writable directory: $SCRATCH_BASE" >&2
  exit 1
fi
JOB_TOKEN="${PBS_JOBID:-manual}"
JOB_TOKEN="${JOB_TOKEN//[^[:alnum:]_.-]/_}"
SCRATCH_ROOT="$(mktemp -d "$SCRATCH_BASE/cdot-stage1-${JOB_TOKEN}.XXXXXX")"

# With no schedulable scratch resource there is no reserved byte count.  Use
# the capacity visible to this job unless the operator supplies a conservative
# SCRATCH_ALLOCATION_BYTES value after measuring the compute nodes.
if [ -z "${SCRATCH_ALLOCATION_BYTES:-}" ]; then
  read -r SCRATCH_BLOCKS SCRATCH_BLOCK_SIZE < <(stat -f -c '%a %S' "$SCRATCH_ROOT")
  SCRATCH_ALLOCATION_BYTES=$((SCRATCH_BLOCKS * SCRATCH_BLOCK_SIZE))
fi
export SCRATCH_ALLOCATION_BYTES

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export BLIS_NUM_THREADS=1

REPORT_DIR="${CAMPAIGN_ROOT}/characterization/rung-${WORKER_COUNT}"
mkdir -p "$REPORT_DIR"

echo "[stage1] scratch_root=$SCRATCH_ROOT"
echo "[stage1] scratch_capacity_bytes=$SCRATCH_ALLOCATION_BYTES"
df -h "$SCRATCH_ROOT" "$CAMPAIGN_ROOT"

"$PYTHON_BIN" -m experiments.packed_runner \
  --work-list "$WORK_LIST" \
  --workers "$WORKER_COUNT" \
  --repetition "$REPETITION" \
  --campaign-id "stage1-w${WORKER_COUNT}-r${REPETITION}" \
  --output-root "$CAMPAIGN_ROOT/shards" \
  --scratch-root "$SCRATCH_ROOT" \
  --allocated-memory-bytes "$ALLOCATED_MEMORY_BYTES" \
  --scratch-allocation-bytes "$SCRATCH_ALLOCATION_BYTES" \
  --report "$REPORT_DIR/repetition-${REPETITION}.json"

# Successful shards remove their own data. Remove the remaining empty worker
# directories, but retain anything non-empty for diagnosis after a failure.
find "$SCRATCH_ROOT" -depth -type d -empty -delete
