#!/bin/bash
#PBS -N cdot-sched-tune
#PBS -q workq
#PBS -J 0-5
#PBS -l select=1:ncpus=12:mem=120gb
#PBS -l place=excl
#PBS -l walltime=04:00:00
#PBS -j oe

set -euo pipefail

cd "$PBS_O_WORKDIR"
source pbs/env.sh

: "${MANIFEST:?set development manifest}"
: "${FORECAST_BUNDLE:?set frozen forecast bundle}"
: "${GUARDED_SURVIVAL_BUNDLE:?set measured empirical survival bundle}"
: "${EVALUATION_ROOT:?set scheduled solver-tuning root}"
: "${INTERFACE_FREEZE:?set Phase-3 tuning interface freeze}"

specs=(
  "scheduled-h2-t10:configs/cohort_mpc_phase3_scheduled_h2_t10_v1.json"
  "scheduled-h3-t10:configs/cohort_mpc_phase3_scheduled_h3_t10_v1.json"
  "scheduled-h6-t10:configs/cohort_mpc_phase3_scheduled_h6_t10_v1.json"
  "scheduled-h3-t30:configs/cohort_mpc_phase3_scheduled_h3_t30_v1.json"
  "scheduled-h6-t30:configs/cohort_mpc_phase3_scheduled_h6_t30_v1.json"
  "calendar-conservative-h3-t30:configs/cohort_mpc_phase3_calendar_conservative_h3_t30_v1.json"
)
spec="${specs[$PBS_ARRAY_INDEX]}"
name="${spec%%:*}"
profile="${spec#*:}"
root="$EVALUATION_ROOT/$name"
mkdir -p "$root/pairs"

"$PYTHON_BIN" scripts/run_mpc_candidate_parallel.py \
  --manifest "$MANIFEST" \
  --forecast-bundle "$FORECAST_BUNDLE" \
  --mpc-profile "$profile" \
  --survival-bundle "$GUARDED_SURVIVAL_BUNDLE" \
  --interface-freeze "$INTERFACE_FREEZE" \
  --seed-start 46101 \
  --total-seeds 12 \
  --steps "${STEPS:-2880}" \
  --workers "${WORKERS:-12}" \
  --work-dir "$root/pairs" \
  --evaluation-stage development \
  --output "$root/evaluation.json" \
  >"$root/runner.log" 2>&1
