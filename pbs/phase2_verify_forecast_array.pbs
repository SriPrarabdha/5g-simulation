#!/bin/bash
#PBS -N cdot-fc-verify
#PBS -q workq
#PBS -l select=1:ncpus=4:mem=12gb
#PBS -l walltime=01:00:00
#PBS -J 0-95
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
source pbs/env.sh
export OMP_NUM_THREADS=4
: "${PHASE2_ROOT:?set Phase-2 artifact root}"
: "${AUDIT_ROOT:?set audit output root}"
"$PYTHON_BIN" -m experiments.check_forecast_environment
index="${PBS_ARRAY_INDEX}"
mkdir -p "$AUDIT_ROOT"
"$PYTHON_BIN" -m experiments.verify_forecast_phase2_shard \
  --root "$PHASE2_ROOT" --group-index "$index" \
  --output "$AUDIT_ROOT/audit-$(printf '%03d' "$index").json"
