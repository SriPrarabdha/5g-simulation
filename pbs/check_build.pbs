#!/bin/bash
#PBS -N upf_check_build
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=00:20:00
#PBS -q workq
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
source pbs/env.sh

echo "================ 1. BYTE COMPILE ================"
"$PYTHON_BIN" -m compileall -q schemas simulator steering experiments tests

echo "================ 2. UNIT TESTS ================"
"$PYTHON_BIN" -m unittest discover -s tests -v

echo "================ 3. END-TO-END SHARD ================"
SMOKE_DIR="$(mktemp -d "${PBS_JOBFS:-${TMPDIR:-/tmp}}/upf-smoke.XXXXXX")"
trap 'rm -rf "$SMOKE_DIR"' EXIT
"$PYTHON_BIN" -m experiments.run_campaign_shard \
    --manifest configs/demo_scenario.json \
    --campaign-id compute-node-smoke \
    --seed 1 \
    --output-root "$SMOKE_DIR"

"$PYTHON_BIN" -m experiments.aggregate_campaign \
    --root "$SMOKE_DIR/schema_major=1/campaign=compute-node-smoke" \
    --expected-shards 1 \
    --output "$SMOKE_DIR/summary.json"
test -s "$SMOKE_DIR/summary.json"
echo "BUILD CHECK PASSED"
