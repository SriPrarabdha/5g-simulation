#!/usr/bin/env bash
#PBS -N phase32-candidates-v1
#PBS -q workq
#PBS -l select=1:ncpus=125
#PBS -l place=excl
#PBS -l walltime=12:00:00
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"
source pbs/env.sh
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 BLIS_NUM_THREADS=1

"$PYTHON_BIN" scripts/run_phase32_candidate_matrix.py \
  --manifest output/manifests/stage1-extreme-packing-1d-s20260817.json \
  --candidate-matrix configs/phase32_candidates_v1.json \
  --interface-freeze output/control-science/v1/phase3.2-interface-freeze-v1.json \
  --work-dir output/control-science/v1/phase3.2-development-v1/work \
  --output-root output/control-science/v1/phase3.2-development-v1 \
  --workers 125 \
  --steps 2880 \
  --seed-start 46449 \
  --total-seeds 24
