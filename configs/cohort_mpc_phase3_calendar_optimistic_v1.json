{
  "schema_version": "cohort-mpc-profile/1.0",
  "profile_id": "cohort-mpc-phase3-calendar-optimistic-v1",
  "development_only": true,
  "mpc": {
    "horizon_windows": 12,
    "timeout_seconds": 2.0,
    "max_group_upf_weight": 0.75,
    "action_blend_fraction": 0.5,
    "max_ul_exposure_increase_fraction": 0.0,
    "guardrail_margin_fraction": 0.0,
    "require_known_future_capacity_event": true,
    "fallback_on_unplanned_capacity_state": true,
    "fallback_on_telemetry_uncertainty": true,
    "fallback_on_stale_survival": true,
    "minimum_survival_samples": 100,
    "scheduled_capacity_factor_bias": 0.15,
    "scheduled_event_start_offset_windows": 2,
    "scheduled_event_end_offset_windows": 2
  }
}
